{
    "compileOnSave": false,
    "angularCompilerOptions": {
        "enableI18nLegacyMessageIdFormat": false,
        "strictInjectionParameters": true,
        "strictInputAccessModifiers": true,
        "strictTemplates": true
    },
    "compilerOptions": {
        "rootDir": ".",
        "sourceMap": true,
        "declaration": false,
        "moduleResolution": "node",
        "allowSyntheticDefaultImports": true,
        "emitDecoratorMetadata": true,
        "experimentalDecorators": true,
        "importHelpers": true,
        "target": "esnext",
        "module": "esnext",
        "typeRoots": ["node_modules/@types", "dist/"],
        "lib": ["es2017", "dom", "esnext"],
        "skipLibCheck": true,
        "skipDefaultLibCheck": true,
        "verbatimModuleSyntax": true,
        "baseUrl": ".",
        "paths": {
            "@trellisorg/dns-validator": ["packages/dns-validator/src/index.ts"],
            "@trellisorg/graphql-codegen-make-export-as-optional": [
                "packages/graphql-codegen-make-export-as-optional/src/index.ts"
            ],
            "@trellisorg/graphql-codegen-restore-export-as-changes": [
                "packages/graphql-codegen-restore-export-as-changes/src/index.ts"
            ],
            "@trellisorg/nest-spectator": ["packages/nest-spectator/src/index.ts"],
            "@trellisorg/rx-dynamic-component": ["packages/rx-dynamic-component/src/index.ts"],
            "@trellisorg/serverless-sharp-loader": ["packages/serverless-sharp-loader/src/index.ts"],
            "@trellisorg/update": ["packages/update/src/index.ts"]
        }
    },
    "exclude": ["node_modules", "tmp"]
}
